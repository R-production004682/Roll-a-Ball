.windows-build {
    padding: 12px;
}

.build-title {
    font-size: 16px;
    -unity-font-style: bold;
    margin-bottom: 12px;
}

.build-row {
    flex-direction: row;
    margin-bottom: 6px;
}

.output-field {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.section-title {
    margin-top: 12px;
    margin-bottom: 6px;
    -unity-font-style: bold;
}

.build-button {
    flex-grow: 1;
    height: 34px;
    margin-top: 12px;
    -unity-font-style: bold;
}
